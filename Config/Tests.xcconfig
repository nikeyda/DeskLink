PRODUCT_BUNDLE_IDENTIFIER = local.nikey.desklink.tests
PRODUCT_NAME = $(TARGET_NAME)
GENERATE_INFOPLIST_FILE = YES
DEVELOPMENT_TEAM[sdk=iphoneos*] = $(DESKLINK_TEAM)
#include "MacSigning.xcconfig"
DERIVE_MACCATALYST_PRODUCT_BUNDLE_IDENTIFIER = NO
TEST_HOST = $(BUILT_PRODUCTS_DIR)/DeskLink.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/DeskLink
BUNDLE_LOADER = $(TEST_HOST)
LD_RUNPATH_SEARCH_PATHS = $(inherited) @loader_path/Frameworks @executable_path/Frameworks
