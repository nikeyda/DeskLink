{
  "sourceLanguage": "en",
  "strings": {
    "Local Network Access Is Off": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地网络访问未开启"
          }
        }
      }
    },
    "In System Settings, go to Privacy & Security → Local Network, allow Telescope, then retry.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「系统设置 → 隐私与安全性 → 本地网络」中允许远程随航访问本地网络，然后重试。"
          }
        }
      }
    },
    "In Settings, go to Privacy & Security → Local Network, allow Telescope, then retry.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「设置 → 隐私与安全性 → 本地网络」中允许远程随航访问本地网络，然后重试。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
