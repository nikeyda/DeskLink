#!/bin/sh
set -eu
run=/run/desklink-wayland
adduser -D -s /bin/sh deskpeer
mkdir -p "$run"
chown deskpeer:deskpeer "$run"
chmod 700 "$run"
chown -R deskpeer:deskpeer /test-tls
cat > "$run/server.conf" <<'EOF'
enable_auth=true
username=fixture
password=WaylandFixture42
private_key_file=/test-tls/key.pem
certificate_file=/test-tls/cert.pem
EOF
chown deskpeer:deskpeer "$run/server.conf"
chmod 600 "$run/server.conf"
cat > "$run/sway.conf" <<'EOF'
xwayland disable
output * mode --custom 800x480
output * bg #1f59a5 solid_color
seat seat0 fallback true
bindsym Return exec /run/desklink-wayland/received-return
exec wayvnc -Linfo -C /run/desklink-wayland/server.conf 127.0.0.1 5903
EOF
cat > "$run/received-return" <<'EOF'
#!/bin/sh
swaymsg 'output * bg #34ae92 solid_color'
touch /run/desklink-wayland/input-received
EOF
chmod 755 "$run/received-return"
: > /tmp/desklink-wayland.log
su -s /bin/sh deskpeer -c 'XDG_RUNTIME_DIR=/run/desklink-wayland WLR_BACKENDS=headless WLR_RENDERER=pixman WLR_LIBINPUT_NO_DEVICES=1 sway --config /run/desklink-wayland/sway.conf' > /tmp/desklink-wayland.log 2>&1 &
tail -n +1 -f /tmp/desklink-wayland.log &
for attempt in $(seq 1 100); do
    if netstat -lnt | grep -q '127.0.0.1:5903 '; then
        socat VSOCK-LISTEN:5903,reuseaddr,fork TCP4:127.0.0.1:5903 &
        echo DESKLINK_WAYVNC_READY
        while [ ! -e "$run/input-received" ]; do sleep 0.25; done
        echo DESKLINK_WAYLAND_INPUT_RECEIVED
        exit 0
    fi
    sleep 0.2
done
tail -45 /tmp/desklink-wayland.log
exit 1
